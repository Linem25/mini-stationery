@model AccountLoginViewModel

@{
    ViewData["Title"] = "Login";
}

<h2 class="page-title">Đăng nhập</h2>

<form class="form-box" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Password"></label>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>
            <input asp-for="RememberMe" /> Ghi nhớ đăng nhập
        </label>
    </div>

    <button class="btn" type="submit">Đăng nhập</button>
</form>

<div class="info-box mt-4">
    <strong>Tài khoản demo:</strong><br />
    Admin: admin@ministationery.test / Admin@123<br />
    Staff: staff@ministationery.test / Staff@123<br />
    User: user@ministationery.test / User@123
</div>