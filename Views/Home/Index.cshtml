@model DashboardViewModel

@{
    ViewData["Title"] = "Final Project Dashboard";
}

<h2 class="page-title">Final Project Dashboard</h2>
<p class="page-description">Tổng quan hệ thống, quyền truy cập và trạng thái vận hành.</p>

<div class="stats-grid">
    <div class="stat-card" style="background:#2563eb; color:white;">
        <div class="stat-label" style="color:white; font-weight:bold;">Stationery</div>
        <div class="stat-number" style="color:white;">@Model.TotalStationeries</div>
        <div class="stat-label" style="color:#dbeafe;">Active + deleted</div>
    </div>

    <div class="stat-card" style="background:#16a34a; color:white;">
        <div class="stat-label" style="color:white; font-weight:bold;">Orders</div>
        <div class="stat-number" style="color:white;">@Model.TotalOrders</div>
        <div class="stat-label" style="color:#dcfce7;">Created by transaction</div>
    </div>

    <div class="stat-card" style="background:#ea580c; color:white;">
        <div class="stat-label" style="color:white; font-weight:bold;">Audit Logs</div>
        <div class="stat-number" style="color:white;">@Model.TotalAuditLogs</div>
        <div class="stat-label" style="color:#ffedd5;">Sensitive actions</div>
    </div>

    <div class="stat-card" style="background:#7c3aed; color:white;">
        <div class="stat-label" style="color:white; font-weight:bold;">Security</div>
        <div class="stat-number" style="color:white;">@Model.SecurityControlsEnabled/@Model.SecurityControlsTotal</div>
        <div class="stat-label" style="color:#ede9fe;">Controls enabled</div>
    </div>
</div>

<div class="stationery-grid mt-4">
    <div class="form-box">
        <h3>Role-based quick actions</h3>
        <ul style="list-style:none; padding-left:0;">
            <li>✓ Admin: Create / Edit / Delete Stationery</li>
            <li>✓ Staff: View Stationery and Orders only</li>
            <li>✓ User: View public catalog</li>
            <li>✓ Anonymous: Login / Register only</li>
        </ul>
    </div>

    <div class="info-box">
        <h3>Security checklist</h3>
        <ul>
            <li>Cookie authentication</li>
            <li>Anti-forgery token on POST</li>
            <li>Razor encoding, no Html.Raw</li>
            <li>EF Core LINQ / parameterized query</li>
            <li>Safe image upload</li>
            <li>Soft delete + Global Query Filter</li>
            <li>Concurrency handling (RowVersion)</li>
            <li>ProblemDetails with errorCode + traceId</li>
        </ul>
    </div>
</div>