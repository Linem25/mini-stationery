@model DashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2 class="page-title">Admin Dashboard</h2>

<div class="stats-grid">
    <div class="stat-card" style="background:#2563eb; color:white;">
        <div class="stat-label" style="color:white;">Stationery</div>
        <div class="stat-number" style="color:white;">@Model.TotalStationeries</div>
        <div class="stat-label" style="color:#dbeafe;">All items</div>
    </div>

    <div class="stat-card" style="background:#16a34a; color:white;">
        <div class="stat-label" style="color:white;">Active</div>
        <div class="stat-number" style="color:white;">@Model.ActiveStationeries</div>
        <div class="stat-label" style="color:#dcfce7;">IsDeleted = false</div>
    </div>

    <div class="stat-card" style="background:#ea580c; color:white;">
        <div class="stat-label" style="color:white;">Deleted</div>
        <div class="stat-number" style="color:white;">@Model.DeletedStationeries</div>
        <div class="stat-label" style="color:#ffedd5;">In trash</div>
    </div>

    <div class="stat-card" style="background:#7c3aed; color:white;">
        <div class="stat-label" style="color:white;">Logs Today</div>
        <div class="stat-number" style="color:white;">@Model.LogsToday</div>
        <div class="stat-label" style="color:#ede9fe;">Serilog entries</div>
    </div>
</div>

<div class="form-box mt-4">
    <h3>Quick Links</h3>
    <div class="stationery-grid">
        <a class="btn btn-light" asp-controller="Stationery" asp-action="Index">Stationery List</a>
        <a class="btn btn-light" asp-controller="Stationery" asp-action="Create">Create Stationery</a>
        <a class="btn btn-light" asp-controller="Stationery" asp-action="Trash">Trash (Deleted)</a>
        <a class="btn btn-light" asp-controller="AuditLogs" asp-action="Index">Audit Logs</a>
        <a class="btn btn-light" href="/Health/Ready">Health Check</a>
        <a class="btn btn-light" href="/ApiDemo/StationeryError?id=9999">API Docs / Demo</a>
    </div>
</div>