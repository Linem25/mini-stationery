@model StationeryDetailViewModel

@{
    ViewData["Title"] = "Stationery Detail";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Stationery Detail</h2>
        <p class="page-description">
            Thông tin chi tiết của mặt hàng trong kho.
        </p>
    </div>

    <a class="btn btn-light" href="/Stationery">
        Quay lại danh sách
    </a>
</div>

<div class="detail-layout">
    <div>
        <table class="table table-bordered">
            <tr>
                <th>ID</th>
                <td>@Model.Id</td>
            </tr>

            <tr>
                <th>Mã hàng</th>
                <td>@Model.Sku</td>
            </tr>

            <tr>
                <th>Tên mặt hàng</th>
                <td>@Model.Name</td>
            </tr>

            <tr>
                <th>Nhóm mặt hàng</th>
                <td>@Model.Category</td>
            </tr>

            <tr>
                <th>Nhà cung cấp</th>
                <td>@Model.Supplier</td>
            </tr>

            <tr>
                <th>Giá bán</th>
                <td>@Model.PriceText</td>
            </tr>

            <tr>
                <th>Số lượng tồn kho</th>
                <td>@Model.Quantity</td>
            </tr>

            <tr>
                <th>Mức tồn tối thiểu</th>
                <td>@Model.MinStock</td>
            </tr>

            <tr>
                <th>Giá trị tồn kho</th>
                <td>@Model.InventoryValueText</td>
            </tr>

            <tr>
                <th>Trạng thái</th>
                <td>@Model.StockStatus</td>
            </tr>

            <tr>
                <th>Gợi ý nhập hàng</th>
                <td>@Model.ReorderSuggestion</td>
            </tr>

            <tr>
                <th>Mô tả</th>
                <td>
                    @* Safe: Razor tự encode, chống XSS *@
                    <p>@Model.Description</p>
                </td>
            </tr>

            <tr>
                <th>Cập nhật lần cuối</th>
                <td>@Model.LastUpdatedText</td>
            </tr>
        </table>
    </div>

    <div>
        <div class="side-card warning">
            <h4>Trạng thái tồn kho</h4>
            <h3>@Model.StockStatus</h3>
            <p>@Model.ReorderSuggestion</p>
        </div>

        <div class="side-card info">
            <h4>Giá trị tồn kho hiện tại</h4>
            <h3>@Model.InventoryValueText</h3>
            <p>Tính theo giá bán và số lượng tồn kho hiện có.</p>
        </div>

        <div class="side-card success">
            <h4>Cập nhật lần cuối</h4>
            <h3>@Model.LastUpdatedText</h3>
            <p>Thông tin mặt hàng được cập nhật gần nhất.</p>
        </div>
    </div>
</div>

<div class="form-box mt-4">
    <h4>Ảnh mặt hàng</h4>

    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl" alt="@Model.Name" style="max-width:200px; display:block; margin-bottom:12px; border-radius:8px;" />
    }
    else
    {
        <p class="text-warning">Chưa có ảnh cho mặt hàng này.</p>
    }

    @if (TempData["Error"] != null)
    {
        <div class="text-danger mb-2">@TempData["Error"]</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="success-box">@TempData["Success"]</div>
    }

<form asp-controller="Stationery" asp-action="Delete" asp-route-id="@Model.Id" method="post"
      class="mt-4"
      onsubmit="return confirm('Bạn chắc chắn muốn xóa mặt hàng này?');">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn" style="background:#dc2626;">Xóa mặt hàng</button>
</form>