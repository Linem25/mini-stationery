@model List<StationeryTrashItemViewModel>

@{
    ViewData["Title"] = "Trash";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Trash - Deleted Stationery</h2>
        <p class="page-description">
            Danh sách các mặt hàng đã bị xóa mềm (soft delete). Có thể Restore lại nếu cần.
        </p>
    </div>

    <a class="btn btn-light" asp-controller="Stationery" asp-action="Index">
        Quay lại danh sách
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="success-box">@TempData["Success"]</div>
}

@if (Model.Count == 0)
{
    <p>Không có mặt hàng nào đã bị xóa.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Tên mặt hàng</th>
                <th>Deleted At</th>
                <th>Deleted By</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@(item.DeletedAt?.ToString("dd/MM/yyyy") ?? "-")</td>
                    <td>admin</td>
                    <td>
                        <form asp-controller="Stationery" asp-action="Restore" asp-route-id="@item.Id"
                              method="post" style="display:inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success">Restore</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="info-box mt-4">
    <h4>Soft Delete Rule</h4>
    <p>
        Delete chỉ set <strong>IsDeleted = true</strong> và <strong>DeletedAt = DateTime.Now</strong>.
        Không xóa record khỏi database.
    </p>
</div>