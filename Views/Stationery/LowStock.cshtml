@model List<StationeryListItemViewModel>

@{
    ViewData["Title"] = "Low Stock Report";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Mặt hàng sắp hết</h2>
        <p class="page-description">
            Dựa theo ngưỡng cấu hình trong appsettings.json (LowStockThreshold).
        </p>
    </div>
</div>

@if (Model.Count == 0)
{
    <p>Không có mặt hàng nào dưới ngưỡng cảnh báo.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Tên mặt hàng</th>
                <th>Nhóm</th>
                <th>Số lượng còn lại</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Category</td>
                    <td class="text-danger">@item.Quantity</td>
                </tr>
            }
        </tbody>
    </table>
}