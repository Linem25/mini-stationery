@model StationeryFilterViewModel

@{
    ViewData["Title"] = "Filter Stationery";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Lọc mặt hàng</h2>
        <p class="page-description">
            Lọc theo nhóm và khoảng giá — dữ liệu chỉ đọc (AsNoTracking).
        </p>
    </div>
</div>

<form class="form-box" asp-controller="Stationery" asp-action="Filter" method="get">
    <div class="form-group">
        <label asp-for="CategoryId">Nhóm mặt hàng</label>
        <select asp-for="CategoryId" class="form-control">
            <option value="">-- Tất cả --</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.Id">@category.Name</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label asp-for="MinPrice">Giá từ</label>
        <input asp-for="MinPrice" class="form-control" placeholder="Ví dụ: 5000" />
    </div>

    <div class="form-group">
        <label asp-for="MaxPrice">Giá đến</label>
        <input asp-for="MaxPrice" class="form-control" placeholder="Ví dụ: 20000" />
    </div>

    <button class="btn" type="submit">Lọc</button>
</form>

@if (Model.Items.Count == 0)
{
    <p class="mt-4">Không có mặt hàng phù hợp.</p>
}
else
{
    <table class="table mt-4">
        <thead>
            <tr>
                <th>Tên mặt hàng</th>
                <th>Nhóm</th>
                <th>Giá bán</th>
                <th>Số lượng</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Category</td>
                    <td>@item.PriceText</td>
                    <td>@item.Quantity</td>
                </tr>
            }
        </tbody>
    </table>
}