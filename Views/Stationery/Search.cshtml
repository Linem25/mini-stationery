@model StationerySearchViewModel

@{
    ViewData["Title"] = "Search Stationery";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Search Stationery</h2>
        <p class="page-description">
            Form GET dùng Query String để tìm kiếm mặt hàng theo từ khóa và giá tối thiểu.
        </p>
    </div>

    <a class="btn btn-light"
       asp-controller="Stationery"
       asp-action="Index">
        Quay lại danh sách
    </a>
</div>

<div class="form-layout">
    <form class="form-box"
          asp-controller="Stationery"
          asp-action="Search"
          method="get">

        <div class="form-group">
            <label asp-for="Keyword">Từ khóa</label>
            <input asp-for="Keyword"
                   class="form-control"
                   placeholder="Ví dụ: bút, vở, kéo" />
        </div>

        <div class="form-group">
            <label asp-for="MinPrice">Giá tối thiểu</label>
            <input asp-for="MinPrice"
                   class="form-control"
                   placeholder="Ví dụ: 10000" />
        </div>

        <button class="btn" type="submit">
            Search
        </button>

        <a class="btn btn-secondary"
           asp-controller="Stationery"
           asp-action="Search">
            Reset
        </a>
    </form>

    <div>
        <h3>Search Result</h3>

        <p>
            Keyword: <strong>@Model.Keyword</strong>
        </p>

        <p>
            Min Price: <strong>@Model.MinPrice</strong>
        </p>

        @if (Model.Items.Count == 0)
        {
            <p>Không tìm thấy mặt hàng phù hợp.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Tên mặt hàng</th>
                        <th>Nhóm</th>
                        <th>Giá bán</th>
                        <th>Số lượng</th>
                        <th>Trạng thái</th>
                        <th>Chi tiết</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Category</td>
                            <td>@item.PriceText</td>
                            <td>@item.Quantity</td>
                            <td>@item.StockStatus</td>
                            <td>
                                <a asp-controller="Stationery"
                                   asp-action="Detail"
                                   asp-route-id="@item.Id">
                                    Xem
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>