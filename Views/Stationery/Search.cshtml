@model StationerySearchAdvancedViewModel

@{
    ViewData["Title"] = "Search Stationery";
}

<h2 class="page-title">Tìm kiếm mặt hàng</h2>

<form class="form-box" asp-controller="Stationery" asp-action="Search" method="get">
    <div class="form-group">
        <label asp-for="Keyword">Từ khóa (tên hoặc mã hàng)</label>
        <input asp-for="Keyword" class="form-control" placeholder="Ví dụ: bút, VPP-0001" />
    </div>

    <div class="form-group">
        <label asp-for="StockStatus">Tình trạng tồn kho</label>
        <select asp-for="StockStatus" class="form-control">
            <option value="">-- Tất cả --</option>
            <option value="out">Hết hàng</option>
            <option value="low">Sắp hết (≤ 10)</option>
            <option value="available">Còn nhiều (> 10)</option>
        </select>
    </div>

    <button class="btn" type="submit">Tìm kiếm</button>
</form>

@if (Model.Items.Count == 0)
{
    <div class="info-box mt-4">
        Không tìm thấy mặt hàng nào phù hợp với điều kiện tìm kiếm.
    </div>
}
else
{
    <table class="table mt-4">
        <thead>
            <tr>
                <th>Mã hàng</th>
                <th>Tên mặt hàng</th>
                <th>Nhóm</th>
                <th>Giá</th>
                <th>Số lượng</th>
                <th>Chi tiết</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.SupplyCode</td>
                    <td>@item.Name</td>
                    <td>@item.Category</td>
                    <td>@item.PriceText</td>
                    <td>@item.Quantity</td>
                    <td><a asp-controller="Stationery" asp-action="Detail" asp-route-id="@item.Id">Xem</a></td>
                </tr>
            }
        </tbody>
    </table>
}