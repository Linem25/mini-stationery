@model List<StationeryListItemViewModel>

@{
    ViewData["Title"] = "Stationery Catalog";
    var totalItems = Model.Count;
}

<div class="page-header">
    <div>
        <h2 class="page-title">Stationery Catalog</h2>
        <p class="page-description">
            Đây là trang danh sách văn phòng phẩm của cửa hàng.
            Giao diện được render bằng Partial View.
        </p>
    </div>

    <div>
        <a class="btn btn-secondary"
           asp-controller="Stationery"
           asp-action="Search">
            Search Stationery
        </a>

        <a class="btn"
           asp-controller="Stationery"
           asp-action="Create">
            Create Stationery
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="success-box">
        @TempData["SuccessMessage"]
    </div>
}

<div class="info-box">
    <strong>Tổng số mặt hàng:</strong> @totalItems
</div>

@if (Model.Count == 0)
{
    <p>Chưa có mặt hàng nào trong hệ thống.</p>
}
else
{
    <div class="stationery-grid">
        @foreach (var item in Model)
        {
            <partial name="_StationeryCard" model="item" />
        }
    </div>
}