@model List<StationeryListItemViewModel>

@{
    ViewData["Title"] = "Stationery Catalog";
    var totalItems = Model.Count;
}

<div class="page-header">
    <div>
        <h2 class="page-title">Stationery Catalog</h2>
        <p class="page-description">
            Đây là trang danh sách văn phòng phẩm của cửa hàng.
        </p>
    </div>

    <div>
        <a class="btn btn-secondary"
           asp-controller="Stationery"
           asp-action="Search">
            Search Stationery
        </a>

        <a class="btn"
           asp-controller="Stationery"
           asp-action="Create">
            Create Stationery
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="success-box">
        @TempData["SuccessMessage"]
    </div>
}

<div class="info-box">
    <strong>Tổng số mặt hàng:</strong> @totalItems
</div>

@if (Model.Count == 0)
{
    <p>Chưa có mặt hàng nào trong hệ thống.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Mã hàng</th>
                <th>Tên mặt hàng</th>
                <th>Nhóm</th>
                <th>Giá bán</th>
                <th>Số lượng</th>
                <th>Chi tiết</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.SupplyCode</td>
                    <td>@item.Name</td>
                    <td>@item.Category</td>
                    <td>@item.PriceText</td>
                    <td>@item.Quantity</td>
                    <td>
                        <a asp-controller="Stationery"
                           asp-action="Detail"
                           asp-route-id="@item.Id">
                            Xem
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<p class="mt-4">
    <a class="btn btn-light" href="/">
        Quay lại trang chủ
    </a>
</p>