@foreach (var item in Model)
{
    <tr>
        <td>@item.SupplyCode</td>
        <td>@item.Name</td>
        <td>@item.PriceText</td>
        <td>@item.Quantity</td>
        <td>
            <a asp-controller="Stationery" asp-action="Detail" asp-route-id="@item.Id">Detail</a>
            |
            <a asp-controller="Stationery" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
            |
            <form asp-controller="Stationery" asp-action="Delete" asp-route-id="@item.Id"
                  method="post" style="display:inline"
                  onsubmit="return confirm('Bạn chắc chắn muốn xóa mặt hàng này?');">
                @Html.AntiForgeryToken()
                <button type="submit" style="background:none;border:none;color:#dc2626;cursor:pointer;padding:0;">Delete</button>
            </form>
        </td>
    </tr>
}